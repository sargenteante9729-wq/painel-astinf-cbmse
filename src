import React from 'react';
import { createRoot } from 'react-dom/client';
import App from './App';
import './styles.css';

createRoot(document.getElementById('root')!).render(
  <React.StrictMode>
    <App />
  </React.StrictMode>,
);
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

:root {
  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  color: #202a39;
  background: #f3f5f8;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  --navy: #101a2b;
  --navy-soft: #1b2a40;
  --red: #c92e3a;
  --muted: #778194;
  --line: #e4e8ef;
  --panel: #fff;
}
* { box-sizing: border-box; }
body { margin: 0; min-width: 320px; }
button, input { font: inherit; }
button { cursor: pointer; }
button:focus-visible, input:focus-visible { outline: 3px solid #77a7ff; outline-offset: 2px; }
.app-shell { min-height: 100vh; }
.sidebar { position: fixed; inset: 0 auto 0 0; z-index: 20; width: 252px; padding: 25px 15px 18px; display: flex; flex-direction: column; background: var(--navy); color: #fff; }
.sidebar-brand { display: flex; justify-content: center; align-items: center; min-height: 112px; padding: 0 8px 20px; border-bottom: 1px solid #ffffff1a; }
.sidebar-brand img { width: 190px; max-height: 100px; object-fit: contain; }
.nav-caption { margin: 25px 10px 10px; color: #8995a8; font-size: 10px; font-weight: 800; letter-spacing: 1.3px; }
.nav-item { display: flex; align-items: center; gap: 11px; width: 100%; padding: 12px 11px; margin: 2px 0; border: 0; border-radius: 8px; background: transparent; color: #d7deea; text-align: left; font-size: 12px; }
.nav-item svg:last-child { margin-left: auto; opacity: .65; }
.nav-item:hover, .nav-item.active { color: #fff; background: #ffffff13; }
.nav-item.active { box-shadow: inset 3px 0 var(--red); }
.nav-sector-dot { width: 9px; height: 9px; flex: 0 0 9px; border-radius: 50%; }
.sidebar-bottom { display: flex; align-items: center; gap: 8px; margin-top: auto; padding: 15px 7px 0; border-top: 1px solid #ffffff1a; color: #aab5c5; font-size: 10px; line-height: 1.5; }
.main { margin-left: 252px; min-width: 0; }
.topbar { position: sticky; top: 0; z-index: 10; height: 66px; display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 0 30px; background: #ffffffed; border-bottom: 1px solid var(--line); backdrop-filter: blur(10px); }
.breadcrumb { display: flex; align-items: center; gap: 10px; color: var(--muted); font-size: 12px; }
.breadcrumb strong { color: #2a3444; }
.institution { display: flex; align-items: center; gap: 10px; color: #667184; font-size: 11px; }
.institution img { width: 32px; height: 32px; object-fit: contain; }
.institution b { color: var(--red); letter-spacing: .7px; }
.workspace { width: min(1500px, 100%); margin: 0 auto; padding: 28px 30px 18px; }
.hero { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 22px; }
.eyebrow { color: var(--red); font-size: 10px; font-weight: 800; letter-spacing: 1.5px; }
.hero h1 { margin: 7px 0 2px; color: var(--navy); font-size: 36px; line-height: 1.1; letter-spacing: -1.6px; }
.hero h1 span { color: var(--red); }
.hero p { margin: 5px 0 0; color: var(--muted); font-size: 13px; }
.button { display: inline-flex; align-items: center; justify-content: center; gap: 9px; min-height: 38px; padding: 0 14px; border: 1px solid transparent; border-radius: 8px; font-size: 12px; font-weight: 700; }
.button-outline { color: #354154; border-color: #dce2ea; background: white; }
.button-outline:hover { background: #f5f7fa; }
.button-primary { color: white; background: var(--red); }
.button-primary:hover { background: #a9222d; }
.summary { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)) minmax(140px, 1.2fr); gap: 12px; margin-bottom: 22px; }
.summary-card, .summary-brand { min-height: 108px; padding: 17px; border: 1px solid var(--line); border-radius: 12px; background: var(--panel); }
.summary-card { display: grid; grid-template-columns: 26px 1fr; align-items: center; column-gap: 10px; }
.summary-card > svg { grid-row: span 2; color: var(--red); }
.summary-card strong { color: var(--navy); font-size: 25px; line-height: 1.1; }
.summary-card span { color: var(--muted); font-size: 10px; }
.summary-brand { display: grid; place-items: center; overflow: hidden; }
.summary-brand img { width: 100%; max-width: 210px; max-height: 72px; object-fit: contain; }
.toolbar { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin: 22px 0 16px; }
.view-tabs { display: flex; align-items: center; gap: 4px; padding: 4px; border: 1px solid var(--line); border-radius: 9px; background: #fff; }
.view-tabs button { display: inline-flex; align-items: center; gap: 7px; padding: 8px 11px; border: 0; border-radius: 6px; color: #6d7788; background: transparent; font-size: 11px; font-weight: 700; }
.view-tabs button.selected { color: var(--navy); background: #edf1f6; }
.search { display: flex; align-items: center; gap: 8px; width: min(320px, 100%); padding: 0 11px; border: 1px solid #dfe4ec; border-radius: 8px; background: #fff; color: #8a94a4; }
.search input { width: 100%; height: 37px; border: 0; outline: 0; color: #273244; background: transparent; font-size: 11px; }
.search button { display: grid; place-items: center; border: 0; color: #697589; background: transparent; }
.sector-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px; }
.sector-card { min-width: 0; overflow: hidden; padding: 0; border: 1px solid var(--line); border-radius: 12px; background: white; text-align: left; transition: border-color .15s, transform .15s, box-shadow .15s; }
.sector-card:hover { transform: translateY(-2px); box-shadow: 0 8px 24px #18283b0d; }
.sector-card.chosen { border-color: var(--red); box-shadow: 0 0 0 1px #c92e3a18; }
.sector-card-top { display: flex; justify-content: space-between; align-items: flex-start; min-height: 84px; padding: 16px; color: white; background: linear-gradient(135deg, var(--sector-color), color-mix(in srgb, var(--sector-color), #111 22%)); }
.sector-card-top span { font-size: 9px; font-weight: 800; letter-spacing: .7px; opacity: .85; }
.sector-card-body { padding: 14px; }
.sector-card h3 { margin: 0 0 5px; color: #202a39; font-size: 13px; }
.sector-card p { min-height: 30px; margin: 0; color: var(--muted); font-size: 10px; line-height: 1.5; }
.sector-card-bottom { display: flex; justify-content: space-between; align-items: center; margin-top: 14px; padding-top: 11px; border-top: 1px solid #edf0f4; color: #687487; font-size: 10px; }
.sector-card-bottom svg { color: var(--red); }
.detail-panel, .list-panel, .org-panel { margin-top: 22px; padding: 22px; border: 1px solid var(--line); border-radius: 12px; background: white; }
.detail-heading { display: flex; align-items: center; gap: 14px; }
.detail-icon { display: grid; place-items: center; width: 48px; height: 48px; flex: 0 0 48px; border-radius: 10px; color: white; }
.detail-heading h2, .root-detail h2 { margin: 4px 0; color: var(--navy); font-size: 21px; }
.detail-heading p, .root-detail p { margin: 0; color: var(--muted); font-size: 12px; line-height: 1.6; }
.detail-columns { display: grid; grid-template-columns: 1.5fr 1fr; gap: 30px; margin-top: 22px; padding-top: 18px; border-top: 1px solid var(--line); }
.detail-columns h3 { margin: 0 0 12px; font-size: 13px; }
.detail-columns ul { display: grid; gap: 9px; margin: 0; padding-left: 18px; color: #566174; font-size: 12px; line-height: 1.6; }
.muted { color: var(--muted); font-size: 12px; line-height: 1.6; }
.list-panel { padding: 8px 18px; }
.list-row { display: flex; align-items: center; gap: 12px; width: 100%; padding: 14px 5px; border: 0; border-bottom: 1px solid #edf0f4; background: white; text-align: left; }
.list-row:last-child { border-bottom: 0; }
.list-row > span:nth-child(2) { display: grid; gap: 4px; flex: 1; }
.list-row strong { color: #283345; font-size: 12px; }
.list-row small { color: var(--muted); font-size: 10px; }
.list-row > svg { color: #8993a2; }
.org-panel { display: flex; flex-direction: column; align-items: center; overflow-x: auto; }
.org-root { display: grid; justify-items: center; gap: 7px; min-width: 210px; padding: 17px 24px; border: 1px solid #263c59; border-radius: 10px; color: white; background: var(--navy); }
.org-root small, .org-node small { font-size: 10px; font-weight: 400; }
.org-connector { width: 2px; height: 28px; background: #cbd2dc; }
.org-grid { display: grid; grid-template-columns: repeat(5, minmax(140px, 1fr)); align-self: stretch; gap: 12px; position: relative; }
.org-node { display: grid; justify-items: start; gap: 7px; min-height: 105px; padding: 14px; border: 1px solid var(--line); border-radius: 9px; background: #fbfcfe; text-align: left; }
.org-node.chosen { border-color: var(--red); background: #fff8f8; }
.org-index { color: var(--red); font-size: 10px; font-weight: 800; }
.org-node strong { font-size: 12px; }
.org-node small { color: var(--muted); }
.root-detail { display: flex; align-items: center; gap: 15px; color: var(--red); }
.empty { grid-column: 1 / -1; padding: 28px; color: var(--muted); text-align: center; font-size: 13px; }
.footer { display: flex; justify-content: space-between; gap: 15px; padding: 22px 2px 5px; color: #8993a2; font-size: 10px; }
.mobile-menu { display: none; }
.intro { position: fixed; inset: 0; z-index: 1000; display: grid; place-items: center; overflow: hidden; color: white; background: #05080d; }
.intro-video { width: 100%; height: 100%; object-fit: contain; }
.intro-branding { position: absolute; top: 22px; left: 28px; right: 28px; display: flex; justify-content: space-between; align-items: center; pointer-events: none; }
.intro-branding img:first-child { width: min(190px, 30vw); max-height: 90px; object-fit: contain; }
.intro-branding img:last-child { width: 56px; height: 56px; object-fit: contain; }
.intro-footer { position: absolute; right: 28px; bottom: 24px; left: 28px; display: flex; align-items: center; justify-content: space-between; gap: 15px; }
.intro-footer > span { font-size: 10px; font-weight: 700; letter-spacing: 1px; }
.intro-actions { display: flex; gap: 8px; }
.intro-fallback { display: grid; justify-items: center; gap: 15px; max-width: 450px; padding: 25px; text-align: center; }
.intro-fallback img { max-width: 230px; max-height: 130px; object-fit: contain; }
.intro-fallback p { color: #d2d8e1; font-size: 13px; }
@media (max-width: 1250px) {
  .workspace { padding-inline: 22px; }
  .topbar { padding-inline: 22px; }
  .sector-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .summary { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .summary-brand { display: none; }
  .org-grid { grid-template-columns: repeat(3, minmax(140px, 1fr)); }
}
@media (max-width: 800px) {
  .sidebar { transform: translateX(-100%); transition: transform .2s ease; box-shadow: 10px 0 30px #0002; }
  .sidebar.sidebar-open { transform: translateX(0); }
  .main { margin-left: 0; }
  .mobile-menu { display: inline-flex; min-width: 38px; padding: 0; }
  .topbar { justify-content: flex-start; padding-inline: 14px; }
  .institution span { display: none; }
  .institution img { width: 28px; height: 28px; }
  .institution b { font-size: 10px; }
  .workspace { padding: 22px 14px; }
  .hero h1 { font-size: 30px; }
  .summary { gap: 8px; }
  .summary-card { grid-template-columns: 1fr; gap: 5px; padding: 12px; }
  .summary-card > svg { grid-row: auto; width: 17px; }
  .summary-card strong { font-size: 21px; }
  .summary-card span { font-size: 9px; }
  .toolbar { align-items: stretch; flex-direction: column; }
  .search { width: 100%; }
  .sector-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .detail-columns { grid-template-columns: 1fr; gap: 22px; }
  .org-grid { grid-template-columns: repeat(2, minmax(140px, 1fr)); }
}
@media (max-width: 440px) {
  .breadcrumb { gap: 5px; font-size: 10px; }
  .hero { align-items: flex-start; }
  .hero .button { padding: 0 9px; font-size: 10px; }
  .summary-card { padding: 9px; }
  .summary-card strong { font-size: 18px; }
  .view-tabs button { gap: 5px; padding: 8px; font-size: 10px; }
  .sector-grid { gap: 8px; }
  .sector-card-body { padding: 11px; }
  .sector-card h3 { font-size: 12px; }
  .detail-panel, .org-panel { padding: 15px; }
  .intro-branding { top: 12px; left: 12px; right: 12px; }
  .intro-branding img:last-child { width: 40px; height: 40px; }
  .intro-footer { left: 12px; right: 12px; bottom: 12px; align-items: flex-end; }
  .intro-footer > span { max-width: 35%; font-size: 8px; line-height: 1.4; }
  .intro-actions { gap: 5px; }
  .intro-actions .button { padding: 0 9px; font-size: 10px; }
  .intro-actions .icon-button { display: none; }
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; animation-duration: .01ms !important; }
